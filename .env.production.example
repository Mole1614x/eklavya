# Copy to a protected operator-only location, fill from the approved secret
# manager, and keep the completed file out of Git.
POSTGRES_USER=eklavya_app
POSTGRES_PASSWORD=
POSTGRES_DB=eklavya
PRODUCTION_DATABASE_URL=

# REDIS_PASSWORD and the percent-encoded password inside PRODUCTION_REDIS_URL
# must represent the same secret.
REDIS_PASSWORD=
PRODUCTION_REDIS_URL=

SECRET_KEY=
PUBLIC_URL=https://learn.example.com
ALLOWED_ORIGINS=https://learn.example.com
ALLOWED_HOSTS=learn.example.com,backend
LOG_LEVEL=INFO

HTTP_PORT=8080
COOKIE_SECURE=true
DATASET_MAX_BYTES=5242880
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT_SECONDS=10
JUDGE_DATABASE_POOL_SIZE=4
JUDGE_DATABASE_MAX_OVERFLOW=4
PUBLIC_CACHE_SECONDS=30
JUDGE_STUCK_SECONDS=60

# Optional direct-TLS override. Prefer a managed load balancer when available.
HTTPS_BIND_ADDRESS=0.0.0.0
HTTPS_PORT=443
TLS_CERTIFICATE_FILE=
TLS_PRIVATE_KEY_FILE=
